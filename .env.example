# SMART ELECTRICITY DEMAND PREDICTION & ENERGY OPTIMIZATION PLATFORM
# Environment Configuration

# Database Configuration (Defaults to local SQLite for quick-start development; use MySQL for production)
DATABASE_URL=sqlite:///./smart_energy.db
# MySQL Example:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/smart_energy

# JWT Security
SECRET_KEY=smart-energy-platform-super-secret-key-2026-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Electricity Tariff Settings (per kWh / unit)
BASE_TARIFF_RATE=7.50
PEAK_TARIFF_MULTIPLIER=1.40
TAX_PERCENTAGE=5.00

# Firebase Cloud Messaging (Optional / mobile notifications)
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=

# Environment
ENVIRONMENT=development
PORT=8000
